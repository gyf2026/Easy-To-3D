{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easy-to-3d.local/schemas/1.0/requirements",
  "type": "object",
  "required": [
    "schema_version",
    "revision",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "description",
          "status",
          "priority",
          "verification"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "proposed",
              "confirmed",
              "assumed",
              "superseded"
            ]
          },
          "priority": {
            "enum": [
              "hard",
              "preference"
            ]
          },
          "source": {},
          "verification": {},
          "value": {},
          "units": {
            "type": "string",
            "minLength": 1
          },
          "annotation_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "variants": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
