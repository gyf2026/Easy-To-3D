{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easy-to-3d.local/schemas/1.0/check_report",
  "type": "object",
  "required": [
    "schema_version",
    "created_at",
    "profiles",
    "input_fingerprint",
    "status",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "profiles": {
      "type": "array",
      "items": {
        "enum": [
          "structure",
          "print",
          "patent"
        ]
      }
    },
    "input_fingerprint": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "unknown"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "unknown",
              "not_applicable"
            ]
          }
        }
      }
    }
  }
}
