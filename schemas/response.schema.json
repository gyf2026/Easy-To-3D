{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easy-to-3d.local/schemas/1.0/response",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "annotation_id",
    "batch_id",
    "source_version_id",
    "result_version_id",
    "text",
    "status",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "annotation_id": {
      "type": "string",
      "minLength": 1
    },
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "source_version_id": {
      "type": "string",
      "minLength": 1
    },
    "result_version_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "addressed",
        "needs_clarification",
        "unresolved"
      ]
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    }
  }
}
