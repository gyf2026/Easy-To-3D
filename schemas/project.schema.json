{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easy-to-3d.local/schemas/1.0/project",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "name",
    "created_at",
    "coordinates",
    "variants",
    "active_version_id",
    "phase",
    "revision"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "coordinates": {
      "const": {
        "units": "mm",
        "handedness": "right",
        "up_axis": "Z"
      }
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "path"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "active_version_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "phase": {
      "enum": [
        "requirements",
        "white_model",
        "refinement",
        "review",
        "delivery"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "language": {
      "enum": [
        "zh",
        "en",
        "ja",
        "fr"
      ]
    }
  }
}
